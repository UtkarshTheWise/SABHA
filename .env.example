# Copy to .env and fill in. .env is git-ignored; never commit it.
# Only the variables you need for the network you are using have to be set.

# Which network `npm run deploy|seed|demo` talks to.
# localhost (npx hardhat node) | besu | sepolia
SABHA_NETWORK=localhost

# --- Signing keys (hosted networks only) --------------------------------------
# Hosted networks never fall back to the public "test test ... junk" mnemonic.
# Generate fresh ones and keep them out of the repo.
#
# Signer 0: deploys the contracts and is the first officer.
DEPLOYER_PRIVATE_KEY=
# Signers 1..19 for the demo's officers and voters. Throwaway; never real funds.
DEMO_MNEMONIC=

# --- Besu QBFT network ---------------------------------------------------------
# Chain id must match besu/.env (the genesis is generated from it).
BESU_CHAIN_ID=1337
# What scripts connect to. For a hosted network this is the public https URL.
BESU_RPC_URL=http://127.0.0.1:8545
# What the browser connects to. Written into the frontend build, so no API keys.
# Leave empty on a local network: the RPC URL above is used.
PUBLIC_RPC_URL_BESU=
EXPLORER_URL_BESU=

# --- Sepolia testnet -----------------------------------------------------------
# RPC URL scripts use. May contain a provider API key, which is why it is kept
# separate from the public one below.
SEPOLIA_RPC_URL=
# A keyless public endpoint the browser can use.
PUBLIC_RPC_URL_SEPOLIA=
# Block explorer base URL, no trailing slash, e.g. a Blockscout instance.
EXPLORER_URL_SEPOLIA=

# --- Local node (rarely needed) ------------------------------------------------
LOCALHOST_RPC_URL=http://127.0.0.1:8545
