# Copy to .env and fill in. .env is git-ignored; never commit it.
# Only the variables you need for the network you are using have to be set.

# Which network `npm run deploy|seed|demo` talks to.
# localhost (npx hardhat node) | besu | sepolia
SABHA_NETWORK=localhost

# --- Signing keys (hosted networks only) --------------------------------------
# Hosted networks never fall back to the public "test test ... junk" mnemonic.
# Generate fresh ones and keep them out of the repo.
#
# Signer 0: deploys the contracts and is the first officer.
DEPLOYER_PRIVATE_KEY=
# Signers 1..19 for the demo's officers and voters. Throwaway; never real funds.
DEMO_MNEMONIC=

# --- Besu QBFT network ---------------------------------------------------------
# Chain id must match besu/.env (the genesis is generated from it).
BESU_CHAIN_ID=40717
# What scripts connect to. For a hosted network this is the public https URL.
BESU_RPC_URL=http://127.0.0.1:8545
# What the browser connects to. Written into the frontend build, so no API keys.
# Leave empty on a local network: the RPC URL above is used.
PUBLIC_RPC_URL_BESU=
EXPLORER_URL_BESU=

# --- Sepolia testnet -----------------------------------------------------------
# The always-on fallback. See docs/DEPLOY_SEPOLIA.md.
#
# RPC URL scripts use. May contain a provider API key, which is why it is kept
# separate from the public one below. A keyless endpoint works for both.
SEPOLIA_RPC_URL=
# An endpoint the browser can use. It ends up in the public frontend bundle, so
# it must carry no API key. Checked on 2026-10-23: a keyless endpoint from
# publicnode.com answered correctly and allowed log queries of 50,000 blocks;
# others limited ranges to 10,000 blocks or rate-limited, and public endpoints
# change, so test one with check-health or a quick eth_getLogs before relying on it.
PUBLIC_RPC_URL_SEPOLIA=
# Block explorer base URL, no trailing slash. Used for links in the dashboard and
# to publish source with `npm run verify`. A Blockscout instance for Sepolia
# answered on 2026-10-23: https://eth-sepolia.blockscout.com
EXPLORER_URL_SEPOLIA=
# Optional. Only needed to also publish source on Etherscan; Blockscout and
# Sourcify need no account.
ETHERSCAN_API_KEY=

# --- The demo ------------------------------------------------------------------
# How long the demo's ballot stays open, in seconds. Five votes take seconds on a
# local node and a minute or two on a public testnet. Default 300.
# DEMO_WINDOW_SECONDS=300

# --- Local node (rarely needed) ------------------------------------------------
LOCALHOST_RPC_URL=http://127.0.0.1:8545
