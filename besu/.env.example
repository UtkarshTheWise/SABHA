# Copy to besu/.env. docker compose reads it automatically; setup.sh reads it too.
# .env is git-ignored.

# Exact Besu release. Pin it, and upgrade on purpose (see DEPLOY.md).
# The image supports both amd64 and arm64, so Oracle Ampere VMs work.
BESU_VERSION=26.10.1

# Chain id baked into the genesis block. 1337 is registered to another network
# and clashes with wallets' built-in "Localhost", so use an unregistered one.
# Must equal BESU_CHAIN_ID in the root .env. Changing it means a new chain:
# run ./setup.sh again.
BESU_CHAIN_ID=40717

# Seconds between blocks while nobody is transacting. A transaction still gets
# a block within two seconds; this only stops the chain filling the disk with
# empty blocks overnight. 0 means "a block every two seconds regardless".
BESU_EMPTY_BLOCK_SECONDS=60

# JVM heap per validator. Four validators run on one machine, so keep the total
# under the machine's RAM with room for the OS: 4 x 1g suits a 4 GB VM.
BESU_HEAP=1g

# Host port on loopback for validator 1's JSON-RPC (ETH, NET, WEB3 only).
# Bound to 127.0.0.1, so it is reachable from the VM itself and over an SSH
# tunnel, never from the internet.
BESU_LOCAL_RPC_PORT=8545

# Host port on loopback for validator 2's admin RPC (ADMIN, QBFT, TXPOOL too).
# Operator use only, through an SSH tunnel.
BESU_ADMIN_RPC_PORT=8546
