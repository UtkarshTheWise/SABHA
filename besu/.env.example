# Copy to besu/.env. docker compose reads it automatically; setup.sh reads it too.
# .env is git-ignored.

# Exact Besu release. Pin it, and upgrade on purpose (see DEPLOY.md).
# The image supports both amd64 and arm64, so Oracle Ampere VMs work.
BESU_VERSION=26.10.1

# Chain id baked into the genesis block. 1337 is registered to another network
# and clashes with wallets' built-in "Localhost", so use an unregistered one.
# Must equal BESU_CHAIN_ID in the root .env. Changing it means a new chain:
# run ./setup.sh again.
BESU_CHAIN_ID=40717

# Seconds between blocks while nobody is transacting. A transaction still gets
# a block within two seconds; this only stops the chain filling the disk with
# empty blocks overnight. 0 means "a block every two seconds regardless".
BESU_EMPTY_BLOCK_SECONDS=60

# JVM heap per validator. Four validators run on one machine. Measured on Besu
# 26.10.1 with a 512m heap, each validator used about 600 MB of RAM in total, so
# four use about 2.4 GB; the gateway and Caddy add little. That fits a 4 GB VM
# and does not fit a 2 GB one. A 1g heap would need roughly 4.6 GB for the four.
# The chain is tiny, so a bigger heap buys nothing for a society's voting load.
BESU_HEAP=512m

# Host port on loopback for validator 1's JSON-RPC (ETH, NET, WEB3 only).
# Bound to 127.0.0.1, so it is reachable from the VM itself and over an SSH
# tunnel, never from the internet.
BESU_LOCAL_RPC_PORT=8545

# Validators 2, 3 and 4 serve the admin RPC (ADMIN, QBFT, TXPOOL) on the host's
# loopback at ports 8546, 8547 and 8548. They are fixed, not settings: reach
# them from your own machine with an SSH tunnel, never publicly.

# --- The public endpoint (docker compose --profile public) --------------------
# Leave these alone for a network that only you reach from your own machine.

# The name members' wallets connect to. Its DNS record must already point at
# this machine and ports 80 and 443 must be open, or Caddy cannot get a
# certificate.
RPC_DOMAIN=rpc.example.org

# Web pages allowed to read the answers: exact origins, or one * inside a label
# for preview deployments. A bare *.host is refused. Separate with spaces.
# This is not access control (a script ignores it); it stops other websites
# using your members' browsers against the endpoint.
FRONTEND_ORIGINS=https://sabha.vercel.app https://sabha-*.vercel.app

# Pinned like Besu. The -alpine variant is small and multi-arch.
CADDY_VERSION=2.11.7

# Uncomment on the server so a plain `docker compose up -d` also starts the
# gateway and Caddy, including after a reboot.
# COMPOSE_PROFILES=public
