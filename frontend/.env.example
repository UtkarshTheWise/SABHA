# Build-time settings for the frontend. Copy to frontend/.env.local for local
# development; on Vercel or Netlify, set the same names in the project settings.
# These end up in a public JavaScript bundle: nothing here may be a secret.
#
# The networks themselves (addresses, chain ids, public RPC URLs, explorers) are
# not set here. `npm run deploy` writes one file per network to
# src/chain/networks/, and hosted networks' files are committed.

# Which network opens first, if the link does not say (?network=sepolia) and the
# visitor has not chosen before. Defaults to the first hosted network, or to the
# local one when running `npm run frontend`.
# VITE_DEFAULT_NETWORK=besu

# Override a network's public RPC address at build time. The name is the network
# key in upper case. Useful to point a preview build at a staging endpoint.
# VITE_RPC_URL_LOCALHOST=http://127.0.0.1:8545
# VITE_RPC_URL_BESU=https://rpc.example.org
# VITE_RPC_URL_SEPOLIA=https://sepolia.example.org

# Origins the page may send requests to besides the networks' own RPC addresses
# (a document gateway, for instance), separated by spaces. The production page
# carries a strict Content-Security-Policy built from the network files; anything
# not listed there or here is blocked by the browser.
# VITE_CSP_EXTRA_CONNECT=https://gateway.example
